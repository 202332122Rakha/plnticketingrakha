-- Run only by an authorized PostgreSQL DBA using psql.
-- Defaults match the launcher: role ticketing_app / database pln_ticketing.
-- No DROP, no reset, no default password. Existing roles are not changed.
\set ON_ERROR_STOP on
SELECT EXISTS(SELECT 1 FROM pg_roles WHERE rolname='ticketing_app') AS role_exists \gset
\if :role_exists
  \echo Role ticketing_app sudah ada. Password/hak akses TIDAK diubah.
\else
  CREATE ROLE ticketing_app LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION;
  \echo Isi password role aplikasi yang kuat. Password tidak masuk ke file ini.
  \password ticketing_app
\endif
SELECT EXISTS(SELECT 1 FROM pg_database WHERE datname='pln_ticketing') AS database_exists \gset
\if :database_exists
  \echo Database pln_ticketing sudah ada. Owner/data TIDAK diubah; DBA wajib memeriksa kesesuaiannya.
\else
  CREATE DATABASE pln_ticketing OWNER ticketing_app ENCODING 'UTF8' TEMPLATE template0;
\endif
SELECT datname, pg_get_userbyid(datdba) AS owner FROM pg_database WHERE datname='pln_ticketing';
\echo Lanjutkan setup aplikasi hanya setelah memastikan nama, owner, dan tujuan database benar.
