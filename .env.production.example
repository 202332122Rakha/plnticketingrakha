# BACKEND ONLY. Konfigurasi Produksi / Managed PostgreSQL (Neon / Supabase / VPS).
# JANGAN PERNAH commit file .env yang berisi kredensial sebenarnya ke GitHub!

# Opsi 1: Menggunakan URL Koneksi Lengkap (Managed PostgreSQL - Neon / Supabase)
DATABASE_URL=postgresql://ticketing_app:GANTI_DENGAN_PASSWORD@ep-sample-pooler.ap-southeast-1.aws.neon.tech/pln_ticketing_v12?sslmode=require

# Opsi 2: Menggunakan parameter terpisah (Orange Pi / Server Lokal)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=pln_ticketing_v12
DB_USER=ticketing_app
DB_PASSWORD=GANTI_DENGAN_PASSWORD_DB_ANDA
DB_SSL=false
DB_SSL_CA=
DB_SSL_SERVERNAME=

# Pool & Timeout settings
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=30000

# Server Node.js / Express
HOST=0.0.0.0
PORT=4100
NODE_ENV=production

# Trusted Proxy (PENTING untuk reverse proxy / Cloudflare Tunnel)
TRUST_PROXY=loopback

# Domain Frontend yang diizinkan CORS (Cloudflare Workers & Localhost)
CLIENT_URL=https://plnticketingrakha.bidangpmp-002.workers.dev,http://localhost:3000,http://127.0.0.1:3000,http://10.10.23.26:4100

# Rahasia session cookie (Wajib diisi string acak minimal 32 karakter!)
# Generate dengan command PowerShell: -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 64 | ForEach-Object {[char]$_})
SESSION_SECRET=GANTI_DENGAN_RANDOM_STRING_MINIMAL_32_KARAKTER_UNTUK_PRODUKSI
