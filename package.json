{
  "name": "pln-ticketing-postgresql",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "node server/index.js",
    "start": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "check:syntax": "node scripts/check-syntax.mjs",
    "test": "node scripts/test-server.mjs",
    "test:frontend": "node scripts/test-frontend.mjs",
    "check": "npm run check:syntax && npm run typecheck && npm test && npm run test:frontend",
    "test:integration": "node server/scripts/run-integration.js",
    "db:create": "node server/create-db.js",
    "db:migrate": "node server/run-migrations.js",
    "db:seed": "node server/seed.js",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:status": "node server/check-db.js",
    "admin:create": "node server/create-admin.js",
    "admin:status": "node server/admin-status.js",
    "db:ready": "node server/ready-db.js",
    "build:verify": "node scripts/build-state.mjs check",
    "connection:show": "node server/launch-config.js",
    "test:powershell": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/Test-PowerShell.ps1"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "4.22.3",
    "lucide-react": "0.546.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "9.2.5",
    "@types/express": "4.17.25",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
