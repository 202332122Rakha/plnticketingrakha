# Konfigurasi Environment Variables - Cloudflare Pages
# =====================================================
# Set variabel-variabel ini di:
#   Cloudflare Pages → Project Anda → Settings → Environment Variables
#
# JANGAN taruh file ini di repository publik.
# File ini hanya sebagai template/dokumentasi.
# =====================================================

# URL backend dari Cloudflare Quick Tunnel di Orange Pi.
# Dapatkan URL ini dengan menjalankan perintah berikut di Orange Pi:
#   bash /opt/pln-ticketing/deploy/05-get-tunnel-url.sh
#
# PENTING: URL ini berubah setiap kali cloudflared di-restart!
# Setiap kali URL berubah, Anda harus:
#   1. Update nilai VITE_API_BASE_URL ini di Cloudflare Pages
#   2. Trigger rebuild deployment (atau push commit baru)

VITE_API_BASE_URL=https://TUNNEL_URL_DARI_ORANGEPI.trycloudflare.com

# =====================================================
# Cara mengatur di Cloudflare Pages:
# 1. Login ke https://dash.cloudflare.com
# 2. Pilih "Pages" di sidebar kiri
# 3. Klik nama proyek Anda
# 4. Klik "Settings" → "Environment variables"
# 5. Klik "Add variable"
# 6. Masukkan:
#      Variable name  : VITE_API_BASE_URL
#      Value          : https://xxxx-xxxx-xxxx.trycloudflare.com
# 7. Klik "Save"
# 8. Pergi ke "Deployments" → klik "..." pada deployment terbaru → "Retry deployment"
#    (atau push commit baru ke repository)
# =====================================================
