# TEMPLATE ONLY. Replace hostname/certificate paths; IT must validate before use.
# Backend remains bound to 127.0.0.1:4000. Do not expose PostgreSQL publicly.
server {
    listen 80;
    server_name ticketing.example.internal;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name ticketing.example.internal;
    ssl_certificate /etc/ssl/certs/ticketing-fullchain.pem;
    ssl_certificate_key /etc/ssl/private/ticketing-key.pem;
    client_max_body_size 15m;
    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
