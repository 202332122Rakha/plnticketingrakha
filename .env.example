# BACKEND ONLY. Copy manually to .env OR use scripts/Setup-Ticketing.ps1.
# Keep DATABASE_URL empty when using the separate DB_* settings.
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=pln_ticketing
DB_USER=ticketing_app
DB_PASSWORD=
# true for a direct TLS connection. false is suitable for localhost / protected SSH tunnel.
DB_SSL=false
DB_SSL_CA=
# Optional DNS name on the PostgreSQL TLS certificate when using a loopback tunnel.
DB_SSL_SERVERNAME=
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=30000
HOST=127.0.0.1
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173,http://127.0.0.1:4173,http://localhost:4000,http://127.0.0.1:4000
# Generate a random secret locally. Blank/missing secrets prevent application startup.
SESSION_SECRET=
# Production behind a reverse proxy on this host only:
# TRUST_PROXY=loopback
# Never put database credentials in VITE_* variables.
